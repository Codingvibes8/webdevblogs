# Neon Postgres connection string (Dashboard → Connection details). Leave empty to serve the seed essays.
DATABASE_URL=

# Clerk keys (Dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated Clerk user ids allowed to write and publish posts, e.g. user_2abc...
ADMIN_USER_IDS=user_3Mc5EYln